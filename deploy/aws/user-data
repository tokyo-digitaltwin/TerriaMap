#cloud-config

package_upgrade: true
package_reboot_if_required: true
packages:
 - curl
 - unzip
 - chrony
 - varnish

# any files to create
write_files:
 - path: /etc/systemd/system/varnish.service
   content: |
    [Unit]
    Description=Varnish HTTP accelerator
    Documentation=https://www.varnish-cache.org/docs/4.1/ man:varnishd
    [Service]
    Type=simple
    LimitNOFILE=131072
    LimitMEMLOCK=82000
    ExecStart=/usr/sbin/varnishd -j unix,user=vcache -F -a :80 -T localhost:6082 -f /etc/varnish/default.vcl -S /etc/varnish/secret -s memcache=malloc,1G -s filecache=file,/tmp/varnish_storage.bin,1G
    ExecReload=/usr/share/varnish/varnishreload
    ProtectSystem=full
    ProtectHome=true
    PrivateTmp=true
    PrivateDevices=true
    [Install]
    WantedBy=multi-user.target

# run all the commands to set this instance up
runcmd:
 - echo 'APT::Periodic::Unattended-Upgrade "1";' >> /etc/apt/apt.conf.d/10periodic
 - mkdir -p /tmp/awscli-install
 - cd /tmp/awscli-install
 - curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip"
 - unzip -q awscliv2.zip
 - ./aws/install
 - aws --version
 - rm -rf /tmp/awscli-install
 - mkdir -p /tmp/nodejs
 - chmod -R 777 /tmp/nodejs
 - cd /tmp/nodejs
 - sudo -u ubuntu curl -o ./install.sh https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.0/install.sh
 - sudo -u ubuntu bash ./install.sh
 - sudo -u ubuntu /bin/bash -c 'source /home/ubuntu/.bashrc'
 - sudo -u ubuntu /bin/bash -c 'export NVM_DIR="$HOME/.nvm" && [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" && nvm install --lts'

# copy and extract the webapps from S3
 - mkdir /tmp/ramfs

# TerriaJS app
 - mount -t ramfs ramfs /tmp/ramfs
 - aws s3 cp --region {{awsRegion}} {{awsS3PackagesPath}}/{{deploymentName}}.tar.gz /tmp/ramfs/ 
 - mkdir /opt/{{deploymentName}}
 - tar xzf /tmp/ramfs/{{deploymentName}}.tar.gz -C /opt/{{deploymentName}}
 - ARCHIVE_DIR=`sha256sum /tmp/ramfs/{{deploymentName}}.tar.gz | awk '{print $1}'`
 - mkdir -p /opt/{{deploymentName}}/wwwroot/$ARCHIVE_DIR
 - cp /tmp/ramfs/{{deploymentName}}.tar.gz /opt/{{deploymentName}}/wwwroot/$ARCHIVE_DIR
 - cp /opt/{{deploymentName}}/varnish/default.vcl /etc/varnish
 - umount /tmp/ramfs
 - chmod -R 777 /opt/{{deploymentName}}/wwwroot

# Create service
 - cd /opt/{{deploymentName}}
 - sudo -u ubuntu /bin/bash -c 'export NVM_DIR="$HOME/.nvm" && [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" && ./node_modules/pm2/bin/pm2 startup systemd -u ubuntu --hp /home/ubuntu'
 - sudo -u ubuntu /bin/bash -c 'export NVM_DIR="$HOME/.nvm" && [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" && ./node_modules/.bin/pm2 start ecosystem-production.config.js --update-env --env production'
 - sudo -u ubuntu /bin/bash -c 'export NVM_DIR="$HOME/.nvm" && [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" && ./node_modules/.bin/pm2 save'

# start/restart services
 - systemctl daemon-reload
 - service rsyslog restart
 - service varnish restart
